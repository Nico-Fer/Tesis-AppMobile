# Modelos de ML — pesan varios MB y se versionan fuera del repo.
# Colocá el .tflite en app/src/main/assets/ y apuntá PoseModelSpec.ACTIVE a su nombre.
*.tflite

# Benchmark de Test Lab: los clips se regeneran desde modelosCV con
# tools/benchmark/preparar_clips.py (clips.json sí se versiona: es el catálogo). La línea
# de base y los resultados sí se versionan, para analizarlos sin regenerar nada.
app/src/androidTest/assets/benchmark/*.mp4

# Credenciales de cuenta de servicio de Firebase/Google Cloud
*service-account*.json
ftl-credenciales*.json
