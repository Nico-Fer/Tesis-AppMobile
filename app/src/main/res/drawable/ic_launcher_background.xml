<?xml version="1.0" encoding="utf-8"?>
<!--
    Disco del launcher: degradé a 135° entre los dos colores de la marca.
    El launcher recorta esta capa con su máscara, así que se dibuja a sangre.
    Los mismos colores están en tools/generate_brand_assets.py (LOGO_TEAL / LOGO_NAVY)
    para los iconos legacy, que no pueden usar este XML.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/ic_launcher_gradient_start"
        android:endColor="@color/ic_launcher_gradient_end"
        android:type="linear" />
</shape>
